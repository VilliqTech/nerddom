{
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "strict",
    "jsxSingleQuote": true,
    "printWidth": 120,
    "quoteProps": "consistent",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        ".*styles.css$",
        "",
        "^react$",
        "^tanstack$",
        "^tanstack/.*$",
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "^@components/(.*)$",
        "^@docs/(.*)$",
        "^@/.*$",
        "^../(?!.*.css$).*$",
        "^./(?!.*.css$).*$",
        "\\.css$"
    ],
    "overrides": [
        {
            "files": "*.mdx",
            "options": {
                "printWidth": 70
            }
        }
    ]
}
